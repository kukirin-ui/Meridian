<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy as backup_rules.xml: the licence travels, the API key does not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="full.key" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="full.key" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>

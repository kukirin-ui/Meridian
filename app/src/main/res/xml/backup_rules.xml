<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Keep the licence (files/full.key); never upload the WebView storage that holds the user's API key. -->
<full-backup-content>
    <include domain="file" path="full.key" />
    <exclude domain="root" path="app_webview" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
</full-backup-content>
